# ============================================================
# HYT Digital Passport - Environment Variables
# ------------------------------------------------------------
# 1. Copy this file and rename the copy to ".env.local"
# 2. Fill in the values from your Google Cloud service account
#    and your Google Sheet.
# 3. NEVER commit ".env.local" to git (it is already ignored).
# ============================================================

# The ID of your Google Sheet.
# Found in the sheet URL:
# https://docs.google.com/spreadsheets/d/1v0RzPcS0iHHsasICaOVsA5P6GNQ2576FaDNoAl4Z9Jk/edit
GOOGLE_SHEET_ID=1v0RzPcS0iHHsasICaOVsA5P6GNQ2576FaDNoAl4Z9Jk

# The service account email from your Google Cloud JSON key.
